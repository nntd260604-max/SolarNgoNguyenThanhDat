{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,assets/**,server/config/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
